PORT=4100
NODE_ENV=development

# Optional comma-separated exact hostnames for an approved private Conga gateway
# or environment not covered by the built-in Conga host allowlist. No schemes,
# paths, ports, or wildcards.
# CONGA_ALLOWED_PLATFORM_HOSTS=approved-gateway.example.internal

# Optional "view in Conga" links on usage-scan results. Placeholders:
# {platformUrl} {id} {objectName} {fieldName} {name}. {id} is the record Id returned
# by the Platform API. Copy the URL of a record page in the Conga admin UI and replace
# the varying parts with placeholders. A link is shown only when every placeholder resolves.
# CONGA_FIELD_URL_TEMPLATE={platformUrl}/path/to/objects/{objectName}/fields/{fieldName}
# Default: {platformUrl}/workflow/{id}/
# CONGA_WORKFLOW_URL_TEMPLATE={platformUrl}/workflow/{id}/
# Default: {platformUrl}/cadmin/field-expression/{id}
# CONGA_FIELD_EXPRESSION_URL_TEMPLATE={platformUrl}/cadmin/field-expression/{id}
# Default: {platformUrl}/cadmin/constraint-rules/edit/{id}
# CONGA_CONSTRAINT_RULE_URL_TEMPLATE={platformUrl}/cadmin/constraint-rules/edit/{id}
# Default: {platformUrl}/cadmin/attribute-based-constraint-rules/edit/{id}
# CONGA_ATTRIBUTE_CONSTRAINT_RULE_URL_TEMPLATE={platformUrl}/cadmin/attribute-based-constraint-rules/edit/{id}
# Optional link from a custom code result to its project page. {name} is the project name.
# CONGA_CUSTOM_CODE_URL_TEMPLATE={platformUrl}/path/to/custom-code/{name}
